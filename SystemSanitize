function Get-VPInstalledPrograms {
    $paths = @(
        "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*",
        "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*",
        "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*"
    )

    # Include uninstall entries belonging to any other user hives currently loaded.
    Get-ChildItem "Registry::HKEY_USERS" -ErrorAction SilentlyContinue |
        Where-Object {
            $_.PSChildName -match '^S-1-5-21-' -and
            $_.PSChildName -notmatch '\.Classes$'
        } | ForEach-Object {
            $paths += "Registry::HKEY_USERS\$($_.PSChildName)\Software\Microsoft\Windows\CurrentVersion\Uninstall\*"
        }

    $items = foreach($path in ($paths | Select-Object -Unique)) {
        Get-ItemProperty -Path $path -ErrorAction SilentlyContinue |
            Where-Object {
                -not [string]::IsNullOrWhiteSpace([string]$_.DisplayName) -and
                [string]::IsNullOrWhiteSpace([string]$_.ParentKeyName)
            }
    }

    @($items | Sort-Object -Property PSPath -Unique)
}

function Invoke-VPCommandLine {
    param([string]$CommandLine)

    if([string]::IsNullOrWhiteSpace($CommandLine)) {
        return [pscustomobject]@{ Success=$false; ExitCode=$null; Detail="No uninstall command" }
    }

    $expanded = [Environment]::ExpandEnvironmentVariables($CommandLine.Trim())
    $filePath = $null
    $arguments = ""

    if($expanded -match '^\s*"([^"]+\.exe)"\s*(.*)$') {
        $filePath = $Matches[1]
        $arguments = $Matches[2]
    } elseif($expanded -match '^\s*(.+?\.exe)\s+(.*)$') {
        $filePath = $Matches[1].Trim('"')
        $arguments = $Matches[2]
    } elseif($expanded -match '^\s*(.+?\.exe)\s*$') {
        $filePath = $Matches[1].Trim('"')
    } else {
        return [pscustomobject]@{ Success=$false; ExitCode=$null; Detail="Could not parse uninstall command" }
    }

    try {
        $startArgs = @{
            FilePath    = $filePath
            Wait        = $true
            PassThru    = $true
            ErrorAction = "Stop"
        }
        if(-not [string]::IsNullOrWhiteSpace($arguments)) {
            $startArgs.ArgumentList = $arguments
        }
        $process = Start-Process @startArgs
        $okCodes = @(0,1605,1614,1641,3010)
        return [pscustomobject]@{
            Success  = ($process.ExitCode -in $okCodes)
            ExitCode = $process.ExitCode
            Detail   = "Exit code $($process.ExitCode)"
        }
    } catch {
        return [pscustomobject]@{ Success=$false; ExitCode=$null; Detail=$_.Exception.Message }
    }
}

function Invoke-VPWingetUninstall {
    param([string]$DisplayName)

    $winget = Get-Command "winget.exe" -ErrorAction SilentlyContinue
    if(-not $winget) {
        return [pscustomobject]@{ Success=$false; ExitCode=$null; Detail="WinGet is unavailable" }
    }

    try {
        $wingetPath = $winget.Source
        $wingetOutput = @(& $wingetPath uninstall --name $DisplayName --exact --silent --force --disable-interactivity --accept-source-agreements 2>&1)
        $exitCode = $LASTEXITCODE
        $detail = (($wingetOutput | Select-Object -Last 4) -join " | ").Trim()
        if([string]::IsNullOrWhiteSpace($detail)) { $detail = "WinGet exit code $exitCode" }
        return [pscustomobject]@{ Success=($exitCode -eq 0); ExitCode=$exitCode; Detail=$detail }
    } catch {
        return [pscustomobject]@{ Success=$false; ExitCode=$null; Detail=$_.Exception.Message }
    }
}

function Invoke-VPProgramUninstall {
    param($Program)

    $displayName = [string]$Program.DisplayName
    $uninstallString = [string]$Program.UninstallString
    $productCode = $null

    if(([string]$Program.PSChildName) -match '^\{[0-9A-Fa-f-]{36}\}$') {
        $productCode = [string]$Program.PSChildName
    } elseif($uninstallString -match '\{[0-9A-Fa-f-]{36}\}') {
        $productCode = $Matches[0]
    }

    $isMsi = ([int]$Program.WindowsInstaller -eq 1) -or
             ($uninstallString -match '(?i)msiexec(\.exe)?')

    if($isMsi -and $productCode) {
        Log "  MSI uninstall: $displayName" "Yellow"
        try {
            $process = Start-Process "msiexec.exe" -ArgumentList "/x $productCode /qn /norestart" -Wait -PassThru -ErrorAction Stop
            $okCodes = @(0,1605,1614,1641,3010)
            return [pscustomobject]@{
                Success  = ($process.ExitCode -in $okCodes)
                ExitCode = $process.ExitCode
                Detail   = "MSI exit code $($process.ExitCode)"
            }
        } catch {
            return [pscustomobject]@{ Success=$false; ExitCode=$null; Detail=$_.Exception.Message }
        }
    }

    if(-not [string]::IsNullOrWhiteSpace([string]$Program.QuietUninstallString)) {
        Log "  Quiet uninstall: $displayName" "Yellow"
        $quietResult = Invoke-VPCommandLine -CommandLine ([string]$Program.QuietUninstallString)
        if($quietResult.Success) { return $quietResult }
        Log "    Quiet command failed; trying WinGet." "DarkGray"
    }

    Log "  WinGet uninstall by installed name: $displayName" "Yellow"
    $wingetResult = Invoke-VPWingetUninstall -DisplayName $displayName
    if($wingetResult.Success) { return $wingetResult }

    # Inno Setup has defined silent switches. Unknown EXE uninstallers are not
    # given guessed switches, because doing that unattended is unsafe.
    if($uninstallString -match '(?i)unins\d*\.exe') {
        Log "    Trying Inno Setup silent uninstall." "DarkGray"
        return Invoke-VPCommandLine -CommandLine ($uninstallString + ' /VERYSILENT /SUPPRESSMSGBOXES /NORESTART')
    }

    return [pscustomobject]@{
        Success  = $false
        ExitCode = $wingetResult.ExitCode
        Detail   = $wingetResult.Detail
    }
}

function Invoke-VendorPurge {
    $profiles = [ordered]@{
        "HP" = [pscustomobject]@{
            Detect    = '(?i)(\bHP\b|Hewlett[- ]Packard)'
            Publisher = '(?i)(\bHP\b|HP Inc|Hewlett[- ]Packard)'
            Appx      = '(?i)(HPSupportAssistant|HPQuickDrop|HPPrivacySettings|HPConnectionOptimizer|HPSmart|myHP|HPJumpStarts|HPWorkWell|HPOrbit|HPRegistration|HPWelcome|HPNotifications|HPPrinterControl|HPPCHardwareDiagnosticsWindows|HPPowerManager|HPSystemInformation|HPEasyClean|HPEnhance|EnergyStar|WolfSecurity)'
            Win32     = '(?i)(HP Support Assistant|HP Support Solutions Framework|HP Connection Optimizer|HP Documentation|HP Notifications|HP JumpStart|HP Registration|HP Welcome|HP WorkWell|HP QuickDrop|HP Privacy Settings|HP Sure (Click|Sense|Run)|HP Wolf Security|HP Client Security|HP Touchpoint Analytics|HP Insights|HP One Agent|myHP|Energy Star)'
        }
        "Dell" = [pscustomobject]@{
            Detect    = '(?i)\bDell\b'
            Publisher = '(?i)\bDell\b'
            Appx      = '(?i)(DellSupportAssist|DellOptimizer|DellDigitalDelivery|DellUpdate|DellCommandUpdate|DellPowerManager|DellCinema|DellMobileConnect|DellCustomerConnect|MyDell|DellPair|DellPeripheralManager)'
            Win32     = '(?i)(Dell SupportAssist|SupportAssist (OS Recovery|Remediation)|Dell Digital Delivery|Dell Optimizer|Dell Customer Connect|Dell Mobile Connect|Dell Cinema|Dell Pair|Dell Peripheral Manager|MyDell|Dell Data Vault|Dell Core Services|Dell Command[^\r\n]*(Update|Power Manager))'
        }
        "Lenovo" = [pscustomobject]@{
            Detect    = '(?i)\bLenovo\b'
            Publisher = '(?i)\bLenovo\b'
            Appx      = '(?i)(LenovoCompanion|LenovoSettings|LenovoID|LenovoVantage|LenovoNow|LenovoWelcome|LenovoAppExplorer|LenovoSmartAppearance)'
            Win32     = '(?i)(Lenovo Vantage|Lenovo Companion|Lenovo App Explorer|Lenovo Welcome|Lenovo Now|Lenovo ID|Lenovo Smart Appearance|Lenovo System Update|Lenovo Service Bridge)'
        }
        "Acer" = [pscustomobject]@{
            Detect    = '(?i)\bAcer\b'
            Publisher = '(?i)\bAcer\b'
            Appx      = '(?i)(AcerRegistration|AcerCollection|AcerCareCenter|AcerJumpStart|AcerProductRegistration)'
            Win32     = '(?i)(Acer Registration|Acer Collection|Acer Care Center|Acer Jumpstart|Acer Product Registration|Acer Portal|abFiles|abPhoto|abDocs|CyberLink[^\r\n]*for Acer)'
        }
        "ASUS" = [pscustomobject]@{
            Detect    = '(?i)(ASUSTeK|\bASUS\b)'
            Publisher = '(?i)(ASUSTeK|\bASUS\b)'
            Appx      = '(?i)(MyASUS|ASUSProductRegistration|ASUSWelcome|ASUSGiftbox|ASUSLiveUpdate|ArmouryCrate|AuraCreator)'
            Win32     = '(?i)(MyASUS|ASUS Product Registration|ASUS Welcome|ASUS Giftbox|ASUS Live Update|Armoury Crate|Aura Creator|ROG Live Service)'
        }
        "MSI" = [pscustomobject]@{
            Detect    = '(?i)(Micro-Star|\bMSI\b)'
            Publisher = '(?i)(Micro-Star|\bMSI\b)'
            Appx      = '(?i)(MSICenter|DragonCenter|CenterFacade|MSIAppPlayer|MSICompanion)'
            Win32     = '(?i)(MSI Center|Dragon Center|MSI App Player|MSI Companion|MSI SDK|MSI NBFoundation Service)'
        }
        "Toshiba" = [pscustomobject]@{
            Detect    = '(?i)(Toshiba|Dynabook)'
            Publisher = '(?i)(Toshiba|Dynabook)'
            Appx      = '(?i)(ToshibaServiceStation|ToshibaRegistration|DynabookServiceStation)'
            Win32     = '(?i)(TOSHIBA Service Station|TOSHIBA Registration|dynabook Service Station|TOSHIBA Start)'
        }
        "Samsung" = [pscustomobject]@{
            Detect    = '(?i)\bSamsung\b'
            Publisher = '(?i)\bSamsung\b'
            Appx      = '(?i)(SamsungStudio|SamsungNotes|SamsungFlow|SamsungGallery|SamsungWelcome|GalaxyBookExperience)'
            Win32     = '(?i)(Samsung Studio|Samsung Notes|Samsung Flow|Samsung Gallery|Samsung Welcome|Galaxy Book Experience)'
        }
    }

    # Hardware-support components are not bloat. Preserve these even when the
    # package carries the detected vendor's name.
    $protectedPattern = '(?i)(driver|firmware|chipset|BIOS|UEFI|Bluetooth|Wireless|WLAN|Ethernet|Touchpad|TrackPoint|Card Reader|Graphics|Display Audio|Audio (Control|Driver)|Thunderbolt|Serial IO|Management Engine|System Interface Foundation|System Control Interface|Hotkey|System Event Utility|SystemEventUtility|Power Management Driver|Quick Access)'

    $manufacturerParts = @()
    foreach($className in @("Win32_ComputerSystem","Win32_BaseBoard","Win32_BIOS")) {
        try {
            $manufacturerParts += (Get-CimInstance $className -ErrorAction Stop).Manufacturer
        } catch {}
    }
    $manufacturer = (($manufacturerParts | Where-Object {
        -not [string]::IsNullOrWhiteSpace([string]$_)
    } | Select-Object -Unique) -join " / ")
    Log "Detected manufacturer data: $manufacturer" "Cyan"

    $vendor = $null
    $profile = $null
    foreach($entry in $profiles.GetEnumerator()) {
        if($manufacturer -match $entry.Value.Detect) {
            $vendor = $entry.Key
            $profile = $entry.Value
            break
        }
    }
    if(-not $vendor) {
        Log "No supported OEM profile matched — vendor purge skipped." "Yellow"
        return [pscustomobject]@{ Vendor="Unknown"; Supported=$false; Removed=0; Failed=0; Restart=$false }
    }

    Log "Inventorying $vendor software..." "Cyan"
    $installedAppx = @(Get-AppxPackage -AllUsers -ErrorAction SilentlyContinue)
    $provisionedAppx = @(Get-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue)
    $installedPrograms = @(Get-VPInstalledPrograms)

    $appxCandidates = @($installedAppx | Where-Object {
        $identity = "$($_.Name) $($_.PackageFullName) $($_.PublisherDisplayName)"
        $identity -match $profile.Appx -and $identity -notmatch $protectedPattern
    } | Sort-Object -Property PackageFullName -Unique)

    $provisionedCandidates = @($provisionedAppx | Where-Object {
        $identity = "$($_.DisplayName) $($_.PackageName)"
        $identity -match $profile.Appx -and $identity -notmatch $protectedPattern
    } | Sort-Object -Property PackageName -Unique)

    $programCandidates = @($installedPrograms | Where-Object {
        $identity = "$($_.DisplayName) $($_.Publisher)"
        $identity -match $profile.Win32 -and $identity -notmatch $protectedPattern
    } | Group-Object -Property {
        "$($_.PSChildName)|$($_.DisplayName)|$($_.UninstallString)"
    } | ForEach-Object { $_.Group[0] })

    Log "Inventory: $($installedAppx.Count) Appx, $($provisionedAppx.Count) provisioned, $($installedPrograms.Count) Win32 entries." "DarkGray"

    $candidates = @()
    $candidates += @($appxCandidates | ForEach-Object { "Appx: $($_.Name)" })
    $candidates += @($provisionedCandidates | ForEach-Object { "Provisioned: $($_.DisplayName)" })
    $candidates += @($programCandidates | ForEach-Object { "Program: $($_.DisplayName)" })

    if($candidates.Count -eq 0) {
        Log "No matching $vendor bloatware was found." "Yellow"
        $vendorAppxInventory = @($installedAppx | Where-Object {
            "$($_.Name) $($_.PublisherDisplayName)" -match $profile.Publisher
        } | Select-Object -ExpandProperty Name -Unique | Sort-Object)
        $vendorProgramInventory = @($installedPrograms | Where-Object {
            "$($_.DisplayName) $($_.Publisher)" -match $profile.Publisher
        } | Select-Object -ExpandProperty DisplayName -Unique | Sort-Object)

        if($vendorAppxInventory.Count -gt 0) {
            Log "Detected $vendor Appx packages not on the removal list:" "Cyan"
            $vendorAppxInventory | Select-Object -First 15 | ForEach-Object { Log "  $_" "Gray" }
        }
        if($vendorProgramInventory.Count -gt 0) {
            Log "Detected $vendor programs not on the removal list:" "Cyan"
            $vendorProgramInventory | Select-Object -First 15 | ForEach-Object { Log "  $_" "Gray" }
        }
        return [pscustomobject]@{ Vendor=$vendor; Supported=$true; Removed=0; Failed=0; Restart=$false }
    }

    Log "Matched $($candidates.Count) curated removal entries:" "Cyan"
    $candidates | ForEach-Object { Log "  $_" "Gray" }
    Log "Proceeding silently. Drivers, firmware, hotkeys and device-support components are protected." "DarkGray"

    $stats = [pscustomobject]@{ Vendor=$vendor; Supported=$true; Removed=0; Failed=0; Restart=$false }

    foreach($package in $appxCandidates) {
        Log "Removing Appx for all users: $($package.Name)" "Yellow"
        try {
            Remove-AppxPackage -Package $package.PackageFullName -AllUsers -ErrorAction Stop
            $stats.Removed++
        } catch {
            $allUsersError = $_.Exception.Message
            Log "  AllUsers failed; trying registered user SIDs." "DarkGray"
            $userFailures = @()
            $registeredUsers = @($package.PackageUserInformation | Where-Object {
                [string]$_.InstallState -eq "Installed"
            })
            foreach($packageUser in $registeredUsers) {
                try {
                    Remove-AppxPackage -Package $package.PackageFullName -User $packageUser.UserSecurityId -ErrorAction Stop
                } catch {
                    $userFailures += $_.Exception.Message
                }
            }
            if($registeredUsers.Count -gt 0 -and $userFailures.Count -eq 0) {
                $stats.Removed++
            } else {
                $stats.Failed++
                Log "  FAILED: $allUsersError" "Red"
            }
        }
    }

    foreach($package in $provisionedCandidates) {
        Log "Deprovisioning for future users: $($package.DisplayName)" "Yellow"
        try {
            Remove-AppxProvisionedPackage -Online -PackageName $package.PackageName -ErrorAction Stop | Out-Null
            $stats.Removed++
        } catch {
            $stats.Failed++
            Log "  FAILED: $($_.Exception.Message)" "Red"
        }
    }

    foreach($program in $programCandidates) {
        $result = Invoke-VPProgramUninstall -Program $program
        if($result.Success) {
            $stats.Removed++
            if($result.ExitCode -in @(1641,3010)) { $stats.Restart=$true }
            Log "  Removed: $($program.DisplayName)" "Green"
        } else {
            $stats.Failed++
            Log "  FAILED: $($program.DisplayName) — $($result.Detail)" "Red"
        }
    }

    $summaryColour = "Green"
    if($stats.Failed -gt 0) { $summaryColour = "Yellow" }
    Log "$vendor purge finished: $($stats.Removed) removed, $($stats.Failed) failed." $summaryColour
    if($stats.Restart) { Log "One or more uninstallers requested a restart." "Yellow" }
    return $stats
}

