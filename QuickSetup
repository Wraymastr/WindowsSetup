function Start-DeviceInfo {
    if($script:infoProcess -and !$script:infoProcess.HasExited){return}
    $script:infoDir=New-RunFolder
    [IO.File]::WriteAllBytes((Join-Path $infoDir 'Device-Info.ps1'),(Get-Asset 'Device-Info.ps1'))
    $script:infoProcess=Start-PowerShell (Join-Path $infoDir 'Device-Info.ps1')
    $script:infoStarted=Get-Date
}
function Start-Installation([string[]]$Selected) {
    if(!$Selected.Count){return}
    if($Preview){Append-Terminal ('[INFO] Preview selection: '+($Selected -join ', '));return}
    $script:lastRun=New-RunFolder
    [IO.File]::WriteAllBytes((Join-Path $lastRun 'Install-Worker.ps1'),(Get-Asset 'Install-Worker.ps1'))
    if('Microsoft.Office' -in $Selected) {[IO.File]::WriteAllBytes((Join-Path $lastRun 'setup.exe'),(Get-Asset 'setup.exe'))}
    $request=@{Selected=@($Selected);Ssid=$ssid;Password=$password;ProfileName=$profileName;OfficeProductId=$OfficeProductId;OfficeLanguage=$OfficeLanguage}
    # Same-user DPAPI handoff; plaintext credentials are not left in the run folder.
    $json=$request | ConvertTo-Json -Compress
    ConvertTo-SecureString $json -AsPlainText -Force | ConvertFrom-SecureString | Set-Content (Join-Path $lastRun 'request.enc')
    $request=$null;$json=$null
    $script:logLines=0
    $terminal.Clear()
    Append-Terminal '[INFO] Starting selected applications...'
    $script:installProcess=Start-PowerShell (Join-Path $lastRun 'Install-Worker.ps1')
    $appsButton.Enabled=$false;$debloatButton.Enabled=$false;$header.Text='INSTALLING';$header.ForeColor=[Drawing.Color]::Turquoise
}
