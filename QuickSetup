# Build every window at 96-DPI coordinates before enabling automatic scaling.
# Otherwise the empty form can scale before its fixed-coordinate children exist.
function Initialize-WindowLayout([Windows.Forms.Form]$Window) {
    $Window.SuspendLayout()
    $Window.AutoScaleMode='None'
    $Window.Font=New-Object Drawing.Font('Segoe UI',9)
}
function Complete-WindowLayout([Windows.Forms.Form]$Window) {
    $Window.AutoScaleDimensions=New-Object Drawing.SizeF(96,96)
    $Window.AutoScaleMode='Dpi'
    $Window.ResumeLayout($true)
    $Window.PerformAutoScale()
    $Window.PerformLayout()
    # Shown runs after the final handle/DPI initialization. Normally no resize
    # is needed. Small screens get a scrollable viewport, never smaller text.
    $Window.Add_Shown({
        param($sender,$eventArgs)
        $area=[Windows.Forms.Screen]::FromControl($sender).WorkingArea
        $maxWidth=[Math]::Max(1,($area.Width-24))
        $maxHeight=[Math]::Max(1,($area.Height-24))
        if($sender.Width -gt $maxWidth -or $sender.Height -gt $maxHeight) {
            $contentSize=$sender.ClientSize
            $sender.AutoScrollMinSize=$contentSize
            $sender.AutoScroll=$true
            $sender.Size=New-Object Drawing.Size([Math]::Min($sender.Width,$maxWidth),[Math]::Min($sender.Height,$maxHeight))
            $sender.Location=New-Object Drawing.Point(($area.Left+[int](($area.Width-$sender.Width)/2)),($area.Top+[int](($area.Height-$sender.Height)/2)))
        }
    })
}
function Get-SuggestedName([string]$Serial,[string]$Prefix,[string]$Fallback) {
    if(!$Serial -or $Serial.Trim() -match '^(Unavailable|Detecting\.\.\.|Unknown|Default string|To be filled by O\.?E\.?M\.?|System Serial Number|0+)$'){return $Fallback}
    $clean=($Serial.ToUpperInvariant() -replace '[^A-Z0-9]','')
    if(!$clean){return $Fallback}
    if($Prefix -notin @('LT','DT')){$Prefix='LT'}
    # Windows computer names are limited to 15 characters; keep the last 12 serial characters.
    if($clean.Length -gt 12){$clean=$clean.Substring($clean.Length-12)}
    return $Prefix+'-'+$clean
}
function New-RunFolder {
    $dir=Join-Path $baseLogs ((Get-Date -Format 'yyyyMMdd-HHmmss')+'-'+[guid]::NewGuid().ToString('N').Substring(0,6))
    $null=New-Item -ItemType Directory -Path $dir -Force
    return $dir
}
function Start-PowerShell([string]$Path) {
    $argsText='-NoLogo -NoProfile -STA -ExecutionPolicy Bypass -File "'+$Path+'"'
    return (Start-Process -FilePath "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe" -ArgumentList $argsText -WindowStyle Hidden -PassThru -RedirectStandardOutput (Join-Path (Split-Path $Path) 'worker-output.log') -RedirectStandardError (Join-Path (Split-Path $Path) 'worker-errors.log'))
}
function Append-Terminal([string]$Text) {
    $terminal.SelectionStart=$terminal.TextLength
    $terminal.SelectionColor=if($Text -match '\[FAIL\]'){[Drawing.Color]::Salmon}elseif($Text -match '\[(WARN|WAIT|SKIP)\]'){[Drawing.Color]::Khaki}elseif($Text -match '\[(OK|DONE)\]'){[Drawing.Color]::LightGreen}else{[Drawing.Color]::Gainsboro}
    $terminal.AppendText($Text+"`r`n")
    $terminal.ScrollToCaret()
}
function Message([string]$Text) {[void][Windows.Forms.MessageBox]::Show($form,$Text,'WRAYNET Setup','OK','Information')}
function Open-AppDefaults([string]$App) {
    $pattern=if($App -eq 'Chrome'){'Google Chrome'}else{'VLC'}
    $uri='ms-settings:defaultapps'
    foreach($path in @('HKLM:\SOFTWARE\RegisteredApplications','HKLM:\SOFTWARE\WOW6432Node\RegisteredApplications')) {
        try {
            if(!(Test-Path $path)){continue}
            $key=Get-Item $path
            $name=@($key.GetValueNames() | Where-Object {$_ -match [regex]::Escape($pattern)}) | Select-Object -First 1
            if($name){$uri+='?registeredAppMachine='+[uri]::EscapeDataString($name);break}
        }catch{}
    }
    # Explorer hands Settings to the interactive desktop shell rather than writing
    # associations under the elevated technician account.
    Start-Process explorer.exe -ArgumentList ('"'+$uri+'"')
    Append-Terminal ('[ACTION] '+$App+' defaults page opened — confirm your choices in Windows.')
}
