$timer.Interval=500
$timer.Add_Tick({
    # Only local file polling on UI thread. No CIM, network or installer waits.
    if($script:infoProcess) {
        $path=Join-Path $infoDir 'info.json'
        if(Test-Path $path) {
            try {
                $data=Get-Content $path -Raw | ConvertFrom-Json
                $values.SERIAL.Text=$data.Serial
                if($data.Model){$values.MODEL.Text=$data.Model}
                $script:domainState=$data.PartOfDomain
                if($data.NamePrefix){$script:namePrefix=$data.NamePrefix}
                $values.WINDOWS.Text=$windowsLabel+' · '+$data.Activation
                $tip.SetToolTip($values.WINDOWS,('Build '+$cv.CurrentBuild+'.'+$cv.UBR+' — click to enter a key'))
                if($data.Complete){$script:infoProcess=$null}
            }catch {}
        }
        if($script:infoProcess -and ($infoProcess.HasExited -or ((Get-Date)-$infoStarted).TotalSeconds -gt 40)) {
            if(!$infoProcess.HasExited){$infoProcess.Kill()}
            if($values.SERIAL.Text -eq 'Detecting...'){$values.SERIAL.Text='Unavailable'}
            $script:infoProcess=$null
        }
    }
    if($script:activationProcess -and $activationProcess.HasExited) {
        $path=Join-Path $activationFolder 'activation.json'
        if(Test-Path $path){
            try {$a=Get-Content $path -Raw | ConvertFrom-Json;Append-Terminal $a.Message}catch {Append-Terminal '[WARN] Could not read activation result.'}
        }else{Append-Terminal '[WARN] Activation worker exited without a result; check Windows Activation settings.'}
        $script:activationProcess=$null;$values.WINDOWS.Enabled=$true
        try{Start-DeviceInfo}catch{}
    }
    if($script:installProcess) {
        $path=Join-Path $lastRun 'ui.log'
        if(Test-Path $path) {
            try {
                $lines=@(Get-Content -LiteralPath $path -Encoding UTF8)
                for($i=$script:logLines;$i -lt $lines.Count;$i++){Append-Terminal $lines[$i]}
                $script:logLines=$lines.Count
            }catch {}
        }
        if($installProcess.HasExited) {
            $done=Join-Path $lastRun 'done.json'
            $ok=$false;$offerDefaults=$false
            if(Test-Path $done){try {$r=Get-Content $done -Raw | ConvertFrom-Json;$ok=($r.ExitCode -eq 0 -and $installProcess.ExitCode -eq 0);$offerDefaults=(@($r.Results | Where-Object {$_.App -eq 'Debloat' -and $_.Status -in @('Complete','Needs review')}).Count -gt 0);if(@($r.Results | Where-Object {$_.Status -eq 'Restart required'}).Count){$script:restartRequired=$true;$restartNotice.Text='Restart required — click to restart'}}catch{}}
            else {Append-Terminal '[FAIL] Installer worker exited without a completion result. See logs.'}
            $header.Text=if($ok){'COMPLETE'}else{'ATTENTION NEEDED'}
            $header.ForeColor=if($ok){[Drawing.Color]::Turquoise}else{[Drawing.Color]::Khaki}
            $script:installProcess=$null;$appsButton.Enabled=$true;$debloatButton.Enabled=$true
            Remove-Item (Join-Path $lastRun 'setup.exe'),(Join-Path $lastRun 'request.enc') -Force -ErrorAction SilentlyContinue
            if($offerDefaults){Show-DefaultChoices}
        }
    }
})
$form.Add_Shown({$timer.Start();try{Start-DeviceInfo}catch{$values.SERIAL.Text='Unavailable'}})
$form.Add_FormClosing({param($sender,$e)
    if(($script:installProcess -and !$installProcess.HasExited) -or ($script:activationProcess -and !$activationProcess.HasExited)) {
        $answer=[Windows.Forms.MessageBox]::Show($form,'A task is still running. Close WRAYNET and leave it running in the background? Logs will still be saved.','WRAYNET Setup','YesNo','Question')
        if($answer -ne 'Yes'){$e.Cancel=$true}
    }
})
Complete-WindowLayout $form
try {[void]$form.ShowDialog()}
finally {
    $timer.Stop();$timer.Dispose()
    if($script:infoProcess -and !$infoProcess.HasExited){$infoProcess.Kill()}
    $logo.Image.Dispose();$form.Dispose();$logoStream.Dispose();$iconStream.Dispose();$tip.Dispose()
}
